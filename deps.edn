;; No third-party dependencies. DICOM Part 10's file structure and Part 5's
;; data element encoding are byte-level formats — a leaf that dragged in an
;; image codec or a DICOM toolkit would defeat the point, which is that this
;; workspace has a real, dependency-free `.cljc` implementation of the wire
;; format instead of a facade over one.
{:paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :cljs {:extra-paths ["test"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
